{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "taxo/collection-table",
  "title": "Taxo Table view",
  "category": "taxo",
  "icon": "editor-table",
  "description": "Bind a model / schema node (e.g. Kontakt, Platine). Shows all datasets for the selected node as a table — columns from attributes, one row per instance.",
  "keywords": ["taxo", "taxo-collection-table", "taxonomie", "liste", "tabelle", "model", "knoten", "node", "attributes", "datasets", "instances"],
  "textdomain": "wp-taxonomy-tree",
  "attributes": {
    "collectionTermId": {
      "type": "number",
      "default": 0
    },
    "instanceId": {
      "type": "string",
      "default": ""
    },
    "instanceName": {
      "type": "string",
      "default": ""
    },
    "rows": {
      "type": "array",
      "default": []
    }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "editorScript": "taxo-collection-table-editor-script",
  "editorStyle": "taxo-collection-table-editor-style",
  "style": "taxo-collection-table-style"
}
